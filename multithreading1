## Full End-to-End Example

```java
import java.util.*;
import java.util.concurrent.*;

/**
 * End-to-end example: Process a batch of "orders" using a fixed thread pool.
 * Each order is a Callable<String>. Results are collected via Future.
 */
public class OrderProcessingSystem {

    public static void main(String[] args) throws Exception {

        int cpuCores = Runtime.getRuntime().availableProcessors();
        ExecutorService executor = Executors.newFixedThreadPool(cpuCores,
            r -> {
                Thread t = new Thread(r);
                t.setName("order-worker-" + t.getId());
                return t;
            });

        List<Callable<String>> orders = new ArrayList<>();
        for (int i = 1; i <= 10; i++) {
            final int orderId = i;
            orders.add(() -> {
                Thread.sleep((long) (Math.random() * 1000));
                return "Order #" + orderId + " processed by " + Thread.currentThread().getName();
            });
        }

        List<Future<String>> futures = executor.invokeAll(orders);

        System.out.println("=== All Orders Processed ===");
        for (Future<String> f : futures) {
            try {
                System.out.println(f.get());
            } catch (ExecutionException e) {
                System.err.println("Order failed: " + e.getCause().getMessage());
            }
        }

        executor.shutdown();
        if (!executor.awaitTermination(15, TimeUnit.SECONDS)) {
            executor.shutdownNow();
        }
        System.out.println("Executor shut down cleanly: " + executor.isTerminated());
    }
}
```

